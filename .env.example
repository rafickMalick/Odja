# ── Base de données ──
DATABASE_URL="postgresql://oja:oja_dev@localhost:55432/oja?schema=public"

# ── Redis (files BullMQ, cache, verrous) ──
REDIS_URL="redis://localhost:56379"

# ── API ──
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Authentification ──
JWT_ACCESS_SECRET=change-moi-en-developpement-uniquement
JWT_REFRESH_SECRET=change-moi-aussi
ARGON2_PEPPER=poivre-local

# ── Métier (cahier client) ──
# Commission Ojà en points de base. 500 = 5 %, AJOUTÉE au prix du créateur.
PLATFORM_COMMISSION_BPS=500
# Versement au créateur : 24 h après validation de la réception par le client.
PAYOUT_HOLD_HOURS=24
# Validation automatique si le client ne clique jamais (à confirmer, § 9-A).
AUTO_VALIDATE_HOURS=72
# Délai de réponse du créateur à une commande. Silence vaut refus (§ 9-D).
SUBORDER_ACCEPT_HOURS=48
# Combien d'heures avant l'échéance on relance l'atelier (LN-06).
SUBORDER_REMINDER_LEAD_HOURS=12
PAYMENT_EXPIRY_MINUTES=30
# Majoration appliquée à la distance à vol d'oiseau pour approcher la
# distance routière réelle.
DISTANCE_SINUOSITY_FACTOR=1.3

# ── Fournisseur de paiement ──
# "simulated" : aucune clé nécessaire, le parcours entier se déroule sans
# agrégateur. "kkiapay" : agrégateur retenu — l'application refuse de démarrer
# sans les quatre variables KKIAPAY_* ci-dessous (voir env.ts). "kadevpay" est
# l'ancien agrégateur, abandonné.
PAYMENT_PROVIDER=simulated

# ── KKiaPay (kkiapay.me) ──
# Les trois clés viennent de Tableau de bord › Développeurs › Clés API ; le
# « hash secret » se définit dans Tableau de bord › Webhooks.
#
#   KKIAPAY_PUBLIC_KEY      clé publique — sûre à exposer, le widget l'utilise
#   KKIAPAY_PRIVATE_KEY     clé privée — jamais côté client
#   KKIAPAY_SECRET_KEY      clé secrète — jamais côté client
#   KKIAPAY_WEBHOOK_SECRET  hash secret du webhook, reçu dans l'en-tête
#                           x-kkiapay-secret de chaque notification
#
# KKIAPAY_MODE=test : sandbox (api-sandbox.kkiapay.me, widget en mode test).
# Les clés KKiaPay n'ont pas de préfixe test/live : c'est ce réglage qui fait
# foi. Il doit valoir "live" en production et "test" partout ailleurs.
#
# Webhook à déclarer sur le tableau de bord :
#   https://votre-domaine.tld/api/v1/webhooks/kkiapay
#
# KKIAPAY_PUBLIC_KEY=
# KKIAPAY_PRIVATE_KEY=
# KKIAPAY_SECRET_KEY=
# KKIAPAY_WEBHOOK_SECRET=
KKIAPAY_MODE=test

# Coordonnées du compte marchand Kadev Pay (pay.kadev.ci). Collez-les ici dès
# qu'elles sont émises — rien d'autre à changer, PAYMENT_PROVIDER=kadevpay
# suffit à activer le circuit réel.
#
#   KADEVPAY_PUBLIC_KEY     clé publique, commence par kdvp_ — sûre à exposer
#                            au navigateur, c'est elle que le widget utilise
#   KADEVPAY_SECRET_KEY     clé secrète, commence par kdvs_ — jamais côté
#                            client, sert aux appels serveur à serveur
#   KADEVPAY_WEBHOOK_SECRET secret de signature des notifications, remis à la
#                            configuration du webhook sur leur tableau de bord
#
# En développement et en recette, utilisez les clés kdvp_test_… / kdvs_test_…
# — l'application refuse de démarrer avec une clé kdvs_test_ en production, et
# refuse tout aussi bien une clé kdvs_live_ hors production (voir env.ts).
#
# KADEVPAY_PUBLIC_KEY=kdvp_test_...
# KADEVPAY_SECRET_KEY=kdvs_test_...
# KADEVPAY_WEBHOOK_SECRET=...
#
# URL de base de leur API — inutile de la changer, seule leur documentation
# publique en fait foi si elle diffère un jour.
# KADEVPAY_BASE_URL=https://pay.kadev.ci/api/v1
#
# "test" tant que les clés sont kdvp_test_ / kdvs_test_, "live" en production.
KADEVPAY_MODE=test

# À déclarer une fois le webhook configuré sur leur tableau de bord :
#   URL de notification → https://votre-domaine.tld/api/v1/webhooks/kadevpay
# Ils n'ont documenté aucun mécanisme de sélection d'opérateur Mobile Money
# (Orange, MTN, Moov, Wave) au-delà de method: "momo" | "card" — ce choix
# semble se faire dans leur propre widget, côté client.

# Ordonnanceur des échéances métier (validation auto, versements,
# refus sans réponse, expiration des paiements). À couper uniquement en test.
SCHEDULER_ENABLED=true

# Limitation de débit sur la connexion, les codes de vérification et la preuve
# de livraison. À ne couper qu'en test.
RATE_LIMIT_ENABLED=true

# Double authentification (TOTP) exigée pour l'espace admin. Laisser à true
# hors des tests : un mot de passe d'admin volé ne doit pas suffire.
ADMIN_MFA_REQUIRED=true

# ── Stockage S3 / MinIO ──
S3_ENDPOINT=http://localhost:59000
S3_BUCKET=oja-dev
S3_ACCESS_KEY=oja
S3_SECRET_KEY=oja_dev_secret

# ── E-mail (Mailpit en local) ──
SMTP_HOST=localhost
SMTP_PORT=51025

# ── Front ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:59000/oja-dev-public

# Vérification du téléphone par SMS. Mise de côté : le compte s'ouvre à
# l'e-mail. Passer à true pour la réactiver (elle a sa place à la première
# commande, pas à l'inscription).
REQUIRE_PHONE_VERIFICATION=false
MAIL_FROM="Ojà <bonjour@oja.market>"
# Liste Brevo où copier les abonnés à la newsletter. Vide : base seulement.
BREVO_NEWSLETTER_LIST_ID=
